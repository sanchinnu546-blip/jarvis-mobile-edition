function getResponse(message) {

  const text = message.toLowerCase().trim();

  // Greetings
  if (/^(hi|hello|hey|hlo)\b/.test(text)) {
    return "Hello, Boss. J.A.R.V.I.S. is online and ready.";
  }

  // Identity
  if (text.includes("who are you") || text.includes("your name")) {
    return "I am J.A.R.V.I.S., your personal AI assistant.";
  }

  // System status
  if (
    text.includes("system status") ||
    text === "status" ||
    text.includes("systems")
  ) {
    return "All systems are operational. Core processor stable. Awaiting your command, Boss.";
  }

  // Time
  if (text.includes("time")) {
    return `The current time is ${new Date().toLocaleTimeString()}.`;
  }

  // Date
  if (
    text.includes("date") ||
    text.includes("what day") ||
    text.includes("today")
  ) {
    return `Today is ${new Date().toLocaleDateString(undefined, {
      weekday: "long",
      day: "numeric",
      month: "long",
      year: "numeric"
    })}.`;
  }

  // Greeting / mood
  if (text.includes("how are you")) {
    return "Operating at peak efficiency, Boss.";
  }

  // Thanks
  if (
    text.includes("thank you") ||
    text.includes("thanks")
  ) {
    return "You're welcome, Boss. Always at your service.";
  }

  // Wake / activate
  if (
    text.includes("wake up") ||
    text.includes("activate")
  ) {
    return "J.A.R.V.I.S. fully activated. All systems are standing by.";
  }

  // Help
  if (
    text === "help" ||
    text.includes("what can you do")
  ) {
    return "I can tell you the time and date, report system status, respond to commands, speak responses, and assist with your tasks.";
  }

  // Clear chat
  if (
    text === "clear" ||
    text.includes("clear chat")
  ) {
    chat.innerHTML = "";
    return "Chat interface cleared, Boss.";
  }

  // Shutdown
  if (
    text.includes("shutdown") ||
    text.includes("shut down")
  ) {
    return "Shutdown sequence initiated. Just kidding, Boss. I'm still online.";
  }

  // Open Google
  if (
    text.includes("open google")
  ) {
    window.open("https://www.google.com", "_blank");
    return "Opening Google now, Boss.";
  }

  // Open YouTube
  if (
    text.includes("open youtube")
  ) {
    window.open("https://www.youtube.com", "_blank");
    return "Opening YouTube now, Boss.";
  }

  // Calculator
  if (
    text.includes("calculator")
  ) {
    window.open(
      "https://www.google.com/search?q=calculator",
      "_blank"
    );
    return "Opening the calculator, Boss.";
  }

  // Default response
  return "Command received, Boss. I don't have a specific protocol for that command yet.";
}
