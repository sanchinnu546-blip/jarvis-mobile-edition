document.addEventListener('DOMContentLoaded', () => {
  const chat = document.getElementById('chat');
  const input = document.getElementById('msg');
  const send = document.getElementById('send');

  function addMessage(text, sender) {
    const msgDiv = document.createElement('div');
    msgDiv.className = `msg ${sender}`;
    msgDiv.innerText = text;
    chat.appendChild(msgDiv);
    chat.scrollTop = chat.scrollHeight;
    return msgDiv; // Return reference to avoid relying on chat.lastChild
  }

  function handleSend() {
    const text = input.value.trim();
    if (!text) return;

    addMessage('YOU: ' + text, 'user');
    input.value = '';

    // Keep direct reference to the AI response container
    const aiMsgElement = addMessage('J.A.R.V.I.S: Processing...', 'ai');

    setTimeout(() => {
      aiMsgElement.innerText = 'J.A.R.V.I.S: Systems online. How may I assist you, Boss?';
    }, 1000);
  }

  send.addEventListener('click', handleSend);

  // Optional: Allow pressing Enter to send
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') handleSend();
  });
});
